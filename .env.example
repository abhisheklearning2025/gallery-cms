# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. See SETUP-TASKS.md for where each value lives.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string (URI). Used by `pnpm migrate` only.
SUPABASE_DB_URL=

# ── Storage adapter ─────────────────────────────────────────────────────────
# 'r2' (default) | 'supabase'. Swapping this is the only change needed to move
# media off Cloudflare R2 — see lib/storage/index.ts.
STORAGE_DRIVER=r2

# ── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_BUCKET=infinite-gallery
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public read base. Bucket → Settings → Public Development URL, or your custom
# domain. FREE-TIER NOTE: the pub-*.r2.dev URL is rate-limited by Cloudflare and
# is not meant for production traffic — attach a custom domain before sharing
# the gallery widely.
R2_PUBLIC_BASE_URL=

# ── Admin seeding ───────────────────────────────────────────────────────────
# Used once by `pnpm seed`. Delete ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── App ─────────────────────────────────────────────────────────────────────
# Used for absolute URLs (OG images, copyable public links, QR codes).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for the nightly reconciliation cron route: /api/cron/reconcile
CRON_SECRET=
